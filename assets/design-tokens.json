{
  "$source": "https://sportofino.com/ (extracted 2026-11-25, desktop 1905px viewport)",
  "$notes": "colors.brand.success was not observed on the homepage; it is an assumed neutral green to be confirmed on a cart/checkout page.",
  "colors": {
    "brand": {
      "primary": "#1A1A1A",
      "black": "#000000",
      "accent": "#FFAB3D",
      "sale": "#FF5640",
      "error": "#FF5652",
      "success": "#2E7D32"
    },
    "background": {
      "default": "#FFFFFF",
      "light": "#F5F5F5",
      "dark": "#1A1A1A",
      "darker": "#0A0A0A",
      "footer": "#000000",
      "buttonDark": "#2B2B2B",
      "overlay": "rgba(16, 24, 40, 0.08)"
    },
    "text": {
      "primary": "#1A1A1A",
      "secondary": "#707070",
      "muted": "#767676",
      "disabled": "#999999",
      "onDark": "#FFFFFF",
      "onDarkSoft": "#FAFAFA",
      "sale": "#FF5640"
    },
    "border": {
      "light": "#D4D4D4",
      "default": "#A3A3A3"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "\"DMSans-Regular\", \"DM Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "light": "\"DMSans-Light\", \"DM Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "medium": "\"DMSans-Medium\", \"DM Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "bold": "\"DMSans-Bold\", \"DM Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif"
    },
    "fontFiles": {
      "DMSans-Light": "assets/fonts/dmsans-light/DMSans-Light.woff2",
      "DMSans-Regular": "assets/fonts/dmsans-regular/DMSans-Regular.woff2",
      "DMSans-Medium": "assets/fonts/dmsans-medium/DMSans-Medium.woff2",
      "DMSans-Bold": "assets/fonts/dmsans-bold/DMSans-Bold.woff2"
    },
    "fontWeights": { "light": 300, "regular": 400, "medium": 500, "bold": 700 },
    "fontSize": {
      "xs": "10px",
      "sm": "12px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "26px",
      "2xl": "30px"
    },
    "lineHeight": { "tight": "1.2", "base": "1.3", "relaxed": "1.45", "omnibus": "1.5" },
    "letterSpacing": { "headingLg": "-0.3px", "headingMd": "-0.15px", "normal": "normal" }
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px"
  },
  "layout": {
    "containerMaxWidth": "1640px",
    "containerPaddingX": "40px",
    "headerHeight": "121px",
    "controlHeight": "32px",
    "mobile": {
      "referenceViewport": "393x659 (iPhone 15)",
      "headerHeight": "97px",
      "sectionHeading": { "fontFamily": "DMSans-Light", "fontSize": "24px", "lineHeight": "31.2px" },
      "tileLabel": { "fontSize": "16px", "lineHeight": "23.2px", "padding": "10px 20px 4px" },
      "productName": { "fontSize": "12px", "lineHeight": "17.4px" },
      "promoHeading": { "fontFamily": "DMSans-Light", "fontSize": "26px", "lineHeight": "32.5px" },
      "footerAccordionTitle": { "fontSize": "16px", "lineHeight": "20px", "padding": "16px 0" }
    }
  },
  "borderRadius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "999px",
    "circle": "50%"
  },
  "shadow": {
    "card": "0 .5em 1em -.125em rgba(10, 10, 10, .1), 0 0 0 1px rgba(10, 10, 10, .02)"
  },
  "components": {
    "button": {
      "primary": {
        "backgroundColor": "#2B2B2B",
        "color": "#FFFFFF",
        "border": "1px solid #2B2B2B",
        "padding": "10px 20px",
        "borderRadius": "6px",
        "fontSize": "14px",
        "fontWeight": 400,
        "textTransform": "uppercase",
        "height": "38px"
      },
      "onImage": {
        "backgroundColor": "#FFFFFF",
        "color": "#000000",
        "padding": "0 16px",
        "borderRadius": "4px",
        "fontSize": "12px",
        "height": "32px"
      },
      "carouselArrow": {
        "backgroundColor": "transparent",
        "color": "#1A1A1A",
        "border": "1px solid #A3A3A3",
        "borderDisabled": "1px solid #D4D4D4",
        "borderRadius": "999px",
        "size": "32px"
      }
    },
    "promoBar": { "backgroundColor": "#FFAB3D", "color": "#000000", "fontSize": "16px", "textDecoration": "underline" },
    "header": { "backgroundColor": "#FFFFFF", "color": "#1A1A1A", "fontSize": "14px", "logoWidth": "96px" },
    "nav": { "color": "#1A1A1A", "colorHighlight": "#FF5652", "fontSize": "14px", "fontWeight": 400, "textTransform": "uppercase (content)" },
    "searchInput": {
      "backgroundColor": "#F5F5F5",
      "color": "#1A1A1A",
      "borderRadius": "999px",
      "padding": "0 40px 0 20px",
      "fontSize": "14px"
    },
    "productCard": {
      "imageBackground": "#F5F5F5",
      "brand": { "color": "#707070", "fontFamily": "DMSans-Light", "fontSize": "14px" },
      "name": { "color": "#1A1A1A", "fontSize": "14px", "lineHeight": "20.3px" },
      "price": { "color": "#1A1A1A", "fontSize": "14px" },
      "priceSale": { "color": "#FF5640", "fontSize": "14px" },
      "priceOmnibus": { "color": "#707070", "fontSize": "10px", "lineHeight": "15px" },
      "badge": { "backgroundColor": "#1A1A1A", "color": "#FFFFFF", "fontSize": "14px", "padding": "4px 0", "borderRadius": "2px", "height": "26px" }
    },
    "sectionHeading": { "fontSize": "26px", "lineHeight": "33.8px", "letterSpacing": "-0.3px", "fontWeight": 400 },
    "promoHeading": { "fontFamily": "DMSans-Light", "fontSize": "30px", "lineHeight": "39px", "letterSpacing": "-0.15px", "fontWeight": 300 },
    "footer": {
      "backgroundColor": "#000000",
      "titleColor": "#707070",
      "linkColor": "#FFFFFF",
      "fontSize": "12px"
    }
  }
}
