# OpenRouter API key for both models (server only, required)
OPENROUTER_API_KEY=
# Multimodal LLM for escalated decisions and chat (required; image input, structured outputs, tools)
LLM_MODEL=openai/gpt-6-luna
# Decision model for screening (required; Decisions API, image input)
DECISIONS_MODEL=openai/gpt-6-luna-decisions
# Decision mode: hybrid | decisions-only | llm-always (optional, default hybrid)
DECISION_MODE=hybrid
# Minimum certainty 0.5-0.99 for a confident screening answer (optional, default 0.80)
DECISIONS_CONFIDENCE_THRESHOLD=0.80
# Folder with the policy files (optional, default ../docs/policies)
POLICIES_DIR=../docs/policies
# IANA time zone used for "today" (optional, default Europe/Warsaw)
APP_TIME_ZONE=Europe/Warsaw
